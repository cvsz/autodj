# CamfrogAutoDJ - Local environment variables for build/tooling
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# The application reads config.toml for runtime settings; .env is only for shell/tooling variables.

# --- Code signing (used by build.ps1 and release workflow) ---
# AUTODJ_PFX=path/to/certificate.pfx
# AUTODJ_PFX_PASSWORD=your_pfx_password
# AUTODJ_CERT_THUMBPRINT=HEX_THUMBPRINT_OF_CERT_IN_WINDOWS_STORE

# --- GitHub CLI (used by scripts/gh-switch.sh) ---
# GH_TOKEN=your_github_token