# Git
.git/

# Python caches and bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenvs
.venv/
.venv-linux/

# Caches / reports
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tmp/
.coverage
htmlcov/

# Local environment and state (never ship local config/logs into the image)
.env
.env.*
.git-credentials
config.toml
config.toml.bak
config.toml.tmp
autodj.log
*.log

# Build artifacts
build/
dist/
dist_staging/
artifacts/
AutoDJ.spec
*.exe
*.nsis
*.zip

# OS
.DS_Store

# Credentials / signing material (gh CLI stores tokens under .config/)
.config/
**/.git-credentials
cert/
*.pfx
*.cer
*.pem
*.key

# Forensic / reverse-engineering samples (malware archives, memory dumps,
# packet captures) — must never enter an image
docs/rea/
docs/camfrog-re/
*.pcap
*.dmp

# Bundled runtimes and user/runtime state
mpv/
camfrog_autodj/mpv/
playlist.json
playlist.json.bak
top_requests.json
favorites.json
evidence/
logs/
